# PostgreSQL utama. Salin ke .env.local lalu sesuaikan.
DATABASE_URL=postgresql://cool:cool_local_only@localhost:5432/cool
# Gunakan verify-full untuk PostgreSQL dengan sertifikat TLS publik.
DATABASE_SSL=disable
# Isi hanya jika aplikasi berada di balik reverse proxy tepercaya yang
# MENIMPA header ini (contoh: x-real-ip). Kosong = satu kuota bersama.
TRUSTED_IP_HEADER=
# Opsional, khusus npm run dev:local. Data tersimpan permanen di folder ini.
EMBEDDED_DATABASE_PATH=.data/postgres
